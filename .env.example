# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================================================
# PAYMENT CONFIGURATION - PayMe Direct Integration
# ============================================================================
# The bot uses PayMe Direct Integration (opens PayMe app/website)
# NOT Telegram's native payment system
#
# Get these credentials from:
# 1. PayMe Merchant Dashboard: https://checkout.paycom.uz
# 2. Or contact PayMe support: support@paycom.uz / +998 71 200 0 500
# ============================================================================

# PayMe Direct Integration
PAYME_MERCHANT_ID=your_merchant_id_here
PAYME_SECRET_KEY=your_secret_key_here
PAYME_ENDPOINT=https://checkout.paycom.uz

# OLD (Not used anymore - kept for reference):
# PAYME_PROVIDER_TOKEN=your_payme_provider_token

# Conference Settings
CONFERENCE_PRICE=200000
CURRENCY=UZS

# Admin Configuration
# Get your user ID by sending /start to @userinfobot
ADMIN_USER_ID=your_admin_user_id_here

# Database
DATABASE_PATH=./data/registrations.db
