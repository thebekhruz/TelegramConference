# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================================================
# PAYMENT CONFIGURATION - PayMe Merchant API Integration
# ============================================================================
# The bot uses PayMe Merchant API with automatic payment verification
# PayMe calls your webhook when payments are completed
#
# Get these credentials from:
# 1. PayMe Merchant Dashboard: https://checkout.paycom.uz
# 2. Or contact PayMe support: support@paycom.uz / +998 71 200 0 500
#
# IMPORTANT: You must configure your webhook URL in PayMe dashboard:
# - Webhook URL format: https://your-domain.com/payme-webhook
# - For local testing with ngrok: https://abc123.ngrok.io/payme-webhook
# ============================================================================

# PayMe Merchant API Credentials
PAYME_MERCHANT_ID=your_merchant_id_here
PAYME_SECRET_KEY=your_secret_key_here
PAYME_ENDPOINT=https://checkout.paycom.uz

# Webhook Server Configuration
WEBHOOK_PORT=3000
WEBHOOK_PATH=/payme-webhook

# Conference Settings
CONFERENCE_PRICE=200000
CURRENCY=UZS

# Admin Configuration
# Get your user ID by sending /start to @userinfobot
ADMIN_USER_ID=your_admin_user_id_here

# Database
DATABASE_PATH=./data/registrations.db
