# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Payment Configuration
# Choose payment method: telegram_native or payme_direct
PAYMENT_METHOD=payme_direct

# Telegram Native Payments (if using telegram_native method)
PAYME_PROVIDER_TOKEN=your_payme_provider_token
CLICK_PROVIDER_TOKEN=your_click_provider_token

# PayMe Direct Integration (if using payme_direct method)
# Get these from PayMe merchant dashboard: https://checkout.paycom.uz
PAYME_MERCHANT_ID=your_merchant_id
PAYME_SECRET_KEY=your_secret_key
PAYME_ENDPOINT=https://checkout.paycom.uz

# Conference Settings
CONFERENCE_PRICE=200000
CURRENCY=UZS

# Admin Configuration
# Get your user ID by sending /start to @userinfobot
ADMIN_USER_ID=your_admin_user_id_here

# Database
DATABASE_PATH=./data/registrations.db
