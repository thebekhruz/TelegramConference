# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================================================
# PAYMENT CONFIGURATION - Manual PayMe Transfer
# ============================================================================
# The bot uses MANUAL PayMe transfers (no API integration)
# Users make transfers themselves and submit screenshot for verification
#
# PayMe Account Details (where users should send money):
# Account Number: [Your PayMe account]
# Account Name: [Your business name]
# ============================================================================

# PayMe Account Information (for user instructions)
PAYME_ACCOUNT_NUMBER=your_payme_account_number
PAYME_ACCOUNT_NAME=Your Business Name

# Conference Settings
CONFERENCE_PRICE=200000
CURRENCY=UZS

# Admin Configuration
# Get your user IDs by sending /start to @userinfobot

# Main Admin (You)
ADMIN_USER_ID=your_admin_user_id_here

# Finance Department Admin
FINANCE_ADMIN_USER_ID=finance_admin_user_id_here

# Database
DATABASE_PATH=./data/registrations.db
