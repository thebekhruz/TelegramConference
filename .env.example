# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Payment Provider Tokens
# Get these tokens from @BotFather after connecting payment providers
PAYME_PROVIDER_TOKEN=your_payme_provider_token
CLICK_PROVIDER_TOKEN=your_click_provider_token

# Conference Settings
CONFERENCE_PRICE=200000
CURRENCY=UZS

# Admin Configuration
# Get your user ID by sending /start to @userinfobot
ADMIN_USER_ID=your_admin_user_id_here

# Database
DATABASE_PATH=./data/registrations.db
